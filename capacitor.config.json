{
  "appId": "com.gamremit.app",
  "appName": "GamRemit",
  "webDir": "www",
  "server": {
    "url": "https://gamremit.xyz",
    "cleartext": false,
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "automatic",
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#07090F",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#07090F"
    },
    "CapacitorPasskey": {
      "origin": "https://gamremit.xyz",
      "domains": ["gamremit.xyz"],
      "autoShim": true
    }
  }
}
